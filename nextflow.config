params {
    input       = null
    outdir      = 'results'
    num_designs = 10
    container_rfdiffusion = 'ahhmedsamehh/rfdiffusion-standalone:v1-cu116'
    noise_scale_ca = 0
    noise_scale_frame = 0
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '--gpus all --entrypoint=""'
    }
    pod_native {
        docker.enabled    = false
        apptainer.enabled = false
        process.executor  = 'local'
        process.maxForks  = 4
    }
}
