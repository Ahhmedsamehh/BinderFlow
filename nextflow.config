manifest {
    name = 'Ahhmedsamehh/BinderFlow'
    version = '0.2.0'
    nextflowVersion = '!>=25.10.0'
}

params {
    input = null
    outdir = 'results'
    models = System.getenv('MODELS_PATH')
    num_designs = 10
    design_startnum = 0
    deterministic = true
    container_rfdiffusion = 'binderflow-rfdiffusion:86507b6-cu116'
    python = 'python3.9'
    rfdiffusion_script = '/app/RFdiffusion/scripts/run_inference.py'
    noise_scale_ca = 0
    noise_scale_frame = 0
    cpus = 2
    memory = '8 GB'
    max_forks = 1
    stop_after = 'full'
    sequences_per_backbone = 4
    mpnn_temperature = 0.1
    sequence_seed = 1
    proteinmpnn_python = 'python3.9'
    proteinmpnn_script = '/app/ProteinMPNN/protein_mpnn_run.py'
    container_proteinmpnn = 'binderflow-proteinmpnn:8907e66'
    colabfold_python = 'python'
    colabfold_executable = 'colabfold_batch'
    colabfold_models = null
    // Official ColabFold 1.5.5 / CUDA 11.8 image, pinned by digest.
    container_colabfold = 'ghcr.io/sokrypton/colabfold@sha256:8ba15f66f5b5f59be20e304d15da94ee1519d98367147afff6dcb39e61dfeddb'
    af_num_models = 1
    af_recycles = 3
    structure_seed = 1
    af_memory = '16 GB'
    features_python = 'python3'
    container_features = 'binderflow-features:0.2.0'
    use_containers = true
    ranking_config = "${projectDir}/config/ranking.json"
}

outputDir = params.outdir
workflow.output.mode = 'copy'
process.executor = 'local'
process.shell = ['/bin/bash', '-euo', 'pipefail']
// Serialize local tasks so different GPU stages cannot overlap on one device.
executor.queueSize = 1

profiles {
    conda {
        conda.enabled = true
        conda.useMamba = false
        params.use_containers = false
        params.python = 'python'
        params.proteinmpnn_python = 'python'
        params.colabfold_python = 'python'
        params.features_python = 'python'
    }
    mamba {
        conda.enabled = true
        conda.useMamba = true
        params.use_containers = false
        params.python = 'python'
        params.proteinmpnn_python = 'python'
        params.colabfold_python = 'python'
        params.features_python = 'python'
    }
    micromamba {
        conda.enabled = true
        conda.useMicromamba = true
        params.use_containers = false
        params.python = 'python'
        params.proteinmpnn_python = 'python'
        params.colabfold_python = 'python'
        params.features_python = 'python'
    }
    docker {
        docker.enabled = true
        docker.runOptions = '--gpus all --entrypoint=""'
    }
    pod_native {
        docker.enabled = false
        apptainer.enabled = false
    }
    stub {
        docker.enabled = false
        apptainer.enabled = false
        params.python = 'python3'
        params.cpus = 1
        params.memory = '512 MB'
        params.af_memory = '512 MB'
        params.proteinmpnn_python = 'python3'
        params.colabfold_python = 'python3'
    }
}
